# =====================================================================
# .env.example — Plantilla de variables de entorno
# Copiar a .env y completar con los valores reales
# NUNCA commitear el .env al repositorio
# =====================================================================

# ── Perfil de Spring ──────────────────────────────────────────────────
# Valores posibles: local | azure
SPRING_PROFILES_ACTIVE=azure

# ── Azure PostgreSQL Flexible Server ─────────────────────────────────
AZURE_DB_HOST=sst-postgres-upeu.postgres.database.azure.com
AZURE_DB_NAME=epp_db
AZURE_DB_USER=epp_user
AZURE_DB_PASSWORD=TuPasswordSegura123!

# ── Azure Blob Storage ────────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<cuenta>;AccountKey=<clave>;EndpointSuffix=core.windows.net

# ── JWT ───────────────────────────────────────────────────────────────
# Clave secreta en HEX de 64+ caracteres. Generar con:
# openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# ── Mail (Gmail SMTP) ─────────────────────────────────────────────────
# Usar App Password de Google (no la contraseña real de la cuenta)
# https://support.google.com/accounts/answer/185833
MAIL_USERNAME=correo@upeu.edu.pe
MAIL_PASSWORD=app-password-de-google

# ── Spring SQL Init ───────────────────────────────────────────────────
# 'always' en local para seed inicial, 'never' en producción
SQL_INIT_MODE=never

# ── CORS — orígenes permitidos ────────────────────────────────────────
# URLs del frontend separadas por coma (sin espacios)
# En Azure Container Apps se conoce la URL solo después del primer deploy.
# Formato: https://<app-name>.<unique-id>.<region>.azurecontainerapps.io
# También puedes añadir un dominio custom si lo tienes configurado.
ALLOWED_ORIGINS=https://sst-epp-frontend.azurecontainerapps.io,https://app.upeu.edu.pe